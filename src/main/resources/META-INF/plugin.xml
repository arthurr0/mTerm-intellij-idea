<idea-plugin>
    <id>dev.mterm</id>
    <vendor email="koeckiartur@gmail.com">Artur Kołecki</vendor>

    <description><![CDATA[
        <b>mTerm</b> opens terminal sessions as first-class editor tabs instead of tool-window panels.
        Launch Claude Code, Codex, Grok Build, your own custom agents, or a system terminal in its own tab,
        or open the <b>mTerm</b> grid to run several agents side by side, resize and rearrange them,
        broadcast one prompt to all of them, and see at a glance which one is working and which one
        is waiting for you.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <virtualFileSystem key="mterm"
                           implementationClass="dev.mterm.vfs.MTermFileSystem"
                           physical="false"/>
        <fileEditorProvider implementation="dev.mterm.session.MTermSessionEditorProvider"/>
        <fileEditorProvider implementation="dev.mterm.grid.MTermGridEditorProvider"/>
        <applicationService serviceImplementation="dev.mterm.settings.MTermSettings"/>
        <applicationService serviceImplementation="dev.mterm.agents.AgentRegistry"/>
        <projectService serviceImplementation="dev.mterm.grid.MTermLayoutStore"/>
        <projectService serviceImplementation="dev.mterm.changes.AgentChangeTracker"/>
        <projectService serviceImplementation="dev.mterm.changes.AgentChangeStore"/>
        <projectService serviceImplementation="dev.mterm.changes.ui.AgentChangesUi"/>
        <toolWindow id="Agent Changes"
                    anchor="right"
                    icon="/icons/mterm.svg"
                    factoryClass="dev.mterm.changes.ui.AgentChangesToolWindowFactory"/>
        <applicationConfigurable parentId="tools"
                                 id="dev.mterm.settings"
                                 displayName="mTerm"
                                 instance="dev.mterm.settings.MTermConfigurable"/>
        <notificationGroup id="mTerm" displayType="BALLOON"/>
    </extensions>

    <projectListeners>
        <listener class="dev.mterm.vfs.MTermFileCloseListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <actions>
        <group id="mTerm.NewTabGroup" text="mTerm" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="mTerm.OpenGrid"
                    class="dev.mterm.actions.OpenMTermGridAction"
                    icon="/icons/mterm.svg"
                    text="Open mTerm Grid"
                    description="Open the mTerm multi-agent terminal grid in an editor tab">
                <add-to-group group-id="MainToolbarRight" anchor="first"/>
            </action>
            <action id="mTerm.OpenChanges"
                    class="dev.mterm.actions.OpenAgentChangesAction"
                    text="Show Agent Changes"
                    description="Open the tool window with the files each agent changed"/>
            <separator/>
            <group id="mTerm.Agents" class="dev.mterm.actions.MTermAgentActionGroup"/>
        </group>
    </actions>
</idea-plugin>
